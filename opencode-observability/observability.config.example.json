{
  "$schema": "https://opencode.ai/plugin-config.json",
  "warming": {
    "enabled": true,
    "showStatus": true,
    "showCountdown": true,
    "showConfig": true,
    "showCostEstimate": true,
    "countdownFormat": "compact"
  },
  "cache": {
    "enabled": true,
    "showHitRate": true,
    "showHitRateTrend": true,
    "showReadWriteBreakdown": true,
    "showTTL": true,
    "showSavings": true,
    "showPerTurnDetail": false,
    "rollingWindowTurns": 10,
    "rollingWindowMs": 300000
  },
  "display": {
    "scope": "current",
    "collapsed": false,
    "rememberCollapsed": true,
    "colorIndicators": true,
    "compactMode": false
  },
  "runtime": {
    "refreshIntervalMs": 1000,
    "holdDurationMs": 0,
    "enableLogging": false
  }
}